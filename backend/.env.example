# Copy this file to backend/.env. All settings are optional.
# With no LLM key, chat answers offline from the farm report.

# Free AI chat, option 1: Groq free tier, no credit card (https://console.groq.com/keys).
# LLM_API_KEY=your-free-groq-key
# LLM_MODEL=llama-3.1-8b-instant

# Free AI chat, option 2: Ollama on your own machine, no account (https://ollama.com).
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Comma-separated list of frontend origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173
